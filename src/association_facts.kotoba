;; The CoNEP source catalog, as Kotoba.
;;
;; GENERATED by scripts/gen-kotoba-port.cljs from data/datascript-tx.edn,
;; which src/association/facts.cljc holds as data. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs,
;; which the .cljc cannot. Do not hand-edit -- run the generator, and
;; `--check` will tell you if someone did.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every
;; field of every entry against the .cljc, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "conep"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 11 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 11)) false))

(defn entry-field-0 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "conep.founding-1964-07-03")
    (string=? f "title") (option-some-of [:option :string] "Consejo Nacional de la Empresa Privada (CoNEP) founded in Panama City on 3 July 1964; a non-profit, non-political civil association constituted under ordinal 5 of article 64 of Panama's Civil Code (CoNEP's own Estatutos, article 1)")
    (string=? f "association") (option-some-of [:option :string] "conep")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "PAN")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://conep.org.pa/wp-content/uploads/2026/04/estatutos_conep_completo.pdf")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-conep-org-pa")
    (string=? f "source-article") (option-some-of [:option :string] "1")
    (string=? f "source-quote") (option-some-of [:option :string] "fundado en la ciudad de Panamá, República de Panamá, el 3 de julio de 1964")
    (string=? f "established-date") (option-some-of [:option :string] "1964-07-03")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-08-31")
    :else (option-none-of [:option :string])))

