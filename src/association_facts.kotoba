  (cond
    (string=? f "id") (option-some-of [:option :string] "conep.dissolution-threshold-art-22")
    (string=? f "title") (option-some-of [:option :string] "CoNEP may be dissolved only at an extraordinary meeting convened for that purpose with at least 15 days notice and at least 75% of voting members in favour (Estatutos article 22)")
    (string=? f "association") (option-some-of [:option :string] "conep")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "PAN")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
