;; schema/association-rule.edn — DataScript schema for `association.facts`
;; (ADR-2607141700). Same shape as the sibling
;; cloud-itonami-assoc-9411-sau-fsc / -9411-aut-wko / -9411-irl-ibec /
;; -9411-nzl-businessnz / -9411-cze-spcr / -9411-ind-cii / -9411-zaf-busa /
;; -9411-bra-cni / -9411-ken-kam / -9411-can-chamber / -9411-mex-coparmex /
;; -9411-ita-confindustria / -9411-nld-vnoncw / -9411-kor-kcci /
;; -9411-arg-uia / -9411-bel-feb / -9411-dnk-di / -9411-swe-sn /
;; -9411-fin-ek / -9411-tha-fti / -9411-chl-sofofa / -9411-col-andi /
;; -9411-cri-uccaep / -9411-ecu-cip / -9411-egy-fei / -9411-pry-uip /
;; ... files, PLUS the two provenance attributes described below.
;;
;; :source-article and :source-quote are additions made on 2026-08-31, when
;; conep.org.pa stopped returning HTTP 403 and its own Estatutos became
;; directly readable. Without them a citation can only be checked for
;; reachability, and reachability does not distinguish a URL that states the
;; fact from a URL that merely exists -- the sibling threat-intelligence
;; catalog hit exactly that failure with feeds that returned HTTP 200 and no
;; content. `scripts/verify-catalog.cljs --live` fetches each :url and
;; requires the entry's :source-quote to appear verbatim in it, so a
;; fabricated or drifted citation fails rather than passing quietly.
;;
;; Both are plain attributes (no :db/unique, no :db/cardinality), so merging
;; this schema into root's `scripts/compliance-fact-query.cljs` federation
;; alongside sibling schemas that lack them is a no-op for those siblings --
;; DataScript treats an attribute absent from an entity as absent, not as a
;; conflict.

{:association-rule/id {:db/unique :db.unique/identity}
 :association-rule/title {}
 :association-rule/association {:db/index true}
 :association-rule/isic {:db/index true}
 :association-rule/country {:db/index true}
 :association-rule/kind {:db/index true}
 :association-rule/url {}
 :association-rule/url-provenance {:db/index true}
 :association-rule/source-article {:db/index true}
 :association-rule/source-quote {}
 :association-rule/established-date {}
 :association-rule/last-revised-date {}
 :association-rule/retrieved-at {}
 :association-rule/topic {:db/cardinality :db.cardinality/many :db/index true}}
